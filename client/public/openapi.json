  "paths": {
    "/health": {
      "get": {
        "summary": "Health Check Endpoint",
        "responses": {
          "200": {
            "description": "API is healthy"
          }
        }
      }
    },
    "/templates": {
      "get": {
        "summary": "Fetch Active ATS Resume Templates",
