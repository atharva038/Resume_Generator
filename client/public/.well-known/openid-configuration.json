{
  "issuer": "https://www.smartnshine.app",
  "authorization_endpoint": "https://www.smartnshine.app/login",
  "token_endpoint": "https://www.smartnshine.app/api/auth/token",
  "userinfo_endpoint": "https://www.smartnshine.app/api/auth/me",
  "jwks_uri": "https://www.smartnshine.app/.well-known/jwks.json",
  "response_types_supported": [
    "code",
    "token",
    "id_token"
  ],
  "subject_types_supported": [
    "public"
  ],
  "id_token_signing_alg_values_supported": [
    "RS256",
    "HS256"
  ],
  "scopes_supported": [
    "openid",
    "profile",
    "email"
  ],
  "token_endpoint_auth_methods_supported": [
    "client_secret_basic",
    "client_secret_post"
  ],
  "claims_supported": [
    "sub",
    "name",
    "email",
    "picture"
  ]
}
